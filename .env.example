# Alle Werte sind optional. Ohne .env-Datei startet das Projekt mit
# Seed-Adaptern und regelbasierter Extraktion — die Demo laeuft vollstaendig.

# --- Datenbank ---
# Docker Compose:  npm run db:up
# ohne Docker:     npm run db:local
DATABASE_URL="postgresql://reiseplaner:reiseplaner@localhost:5432/reiseplaner"


# --- Sprachmodell (kostenloses Kontingent, keine Kreditkarte) ---
# Schluessel unter https://aistudio.google.com/apikey erzeugen.
# Neue Schluessel beginnen mit "AQ.", aeltere mit "AIzaSy" — beide gehen.
# Fehlt der Schluessel, greift der regelbasierte Extraktor, und die Anwendung
# bleibt vollstaendig bedienbar.
GEMINI_API_KEY=""
# Optional: bevorzugtes Modell. Es steht dann am Anfang der Kette, ersetzt sie
# aber nicht — ist sein Kontingent aufgebraucht, laeuft der naechste Eintrag
# weiter. Ohne Angabe gilt die Voreinstellung:
#   gemini-flash-lite-latest -> gemini-2.0-flash-lite
#   -> gemini-flash-latest -> gemini-2.0-flash
#
# Die Lite-Varianten stehen vorn, weil das kostenlose Kontingent sie viel
# grosszuegiger behandelt: 500 Anfragen am Tag gegen 20 bei der vollen
# Flash-Variante. Nachzusehen unter https://aistudio.google.com/rate-limit
GEMINI_MODEL=""

# --- Fluganbieter ---
# Duffel Test-Modus: https://duffel.com -> Dashboard -> Test mode
DUFFEL_ACCESS_TOKEN=""

# --- Sprachausgabe ---
# Schluessel unter https://elevenlabs.io -> Profil -> API Keys.
# Fehlt er, liest der Browser die Antworten selbst vor (speechSynthesis).
# Der Knopf "Vorlesen" ist also in beiden Faellen da.
ELEVENLABS_API_KEY=""
# Optional: Stimme aus der Voice Library. Ohne Angabe die im Adapter
# hinterlegte — wer sie auf Deutsch unpassend findet, traegt hier eine
# andere ein und aendert keine Zeile Code.
ELEVENLABS_VOICE_ID=""
# Optional: Voreinstellung ist eleven_multilingual_v2. Die schnelleren
# Modelle sprechen guenstiger, aber hoerbar flacher.
ELEVENLABS_MODEL=""

# --- Guardrails des Agenten ---
AGENT_MAX_ITERATIONS="8"
AGENT_MAX_TOOL_CALLS="20"
AGENT_TOKEN_BUDGET="120000"
GUEST_DAILY_MESSAGE_LIMIT="20"

# --- Veroeffentlichte Fassung ---
# Adresse der Neon-Datenbank. Gehoert in .env.local, nicht hierher, und
# wird ausschliesslich von "npm run db:migrate:deploy" gelesen.
DATABASE_URL_DEPLOY=""
