# Alle Werte sind optional. Ohne .env-Datei startet das Projekt mit
# Seed-Adaptern und regelbasierter Extraktion — die Demo laeuft vollstaendig.

# --- Datenbank ---
# Docker Compose:  npm run db:up
# ohne Docker:     npm run db:local
DATABASE_URL="postgresql://reiseplaner:reiseplaner@localhost:5432/reiseplaner"

# --- Auth.js ---
# Erzeugen mit: npx auth secret
AUTH_SECRET=""

# --- Sprachmodell (kostenloses Kontingent, keine Kreditkarte) ---
# Schluessel unter https://aistudio.google.com -> Get API key
# Fehlt der Schluessel, greift der regelbasierte Extraktor.
GEMINI_API_KEY=""

# --- Fluganbieter ---
# Duffel Test-Modus: https://duffel.com -> Dashboard -> Test mode
DUFFEL_ACCESS_TOKEN=""
# Travelpayouts (echte Preise): https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=""

# --- Guardrails des Agenten ---
AGENT_MAX_ITERATIONS="8"
AGENT_MAX_TOOL_CALLS="20"
AGENT_TOKEN_BUDGET="120000"
GUEST_DAILY_MESSAGE_LIMIT="20"
